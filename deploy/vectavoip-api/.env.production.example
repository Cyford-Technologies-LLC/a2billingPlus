COMPOSE_PROJECT_NAME=vectavoip_api

A2BP_HTTP_PORT=8080

MYSQL_DATABASE=mya2billing
MYSQL_USER=a2billinguser
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT

A2BP_DB_HOST=db
A2BP_DB_NAME=mya2billing
A2BP_DB_USER=a2billinguser
A2BP_DB_PASSWORD=CHANGE_ME
A2BP_DB_DSN=mysql:host=db;dbname=mya2billing;charset=utf8mb4
A2BP_DB_USER_HOST=%

# Optional installer bootstrap credentials. When set, bin/apply-install-migrations.php
# creates A2BP_DB_NAME, creates/updates A2BP_DB_USER, grants privileges, then runs migrations.
A2BP_DB_ADMIN_USER=root
A2BP_DB_ADMIN_PASSWORD=CHANGE_ME_ROOT
A2BP_DB_ADMIN_DSN=mysql:host=db;charset=utf8mb4

A2BP_SECRET_DIR=/run/secrets/a2billingplus
A2BP_API_SERVICE_KEY_FILE=/run/secrets/a2bp_api_service_key

VECTAVOIP_API_BASE_URL=https://api.vectavoip.com
VECTAVOIP_WEBHOOK_SECRET_FILE=/run/secrets/vectavoip_webhook_secret

# DID purchase upstream. Use "local" to sell from cc_vectavoip_did_inventory
# or "twilio" to call Twilio when /v1/dids/purchase is used.
VECTAVOIP_DEFAULT_UPSTREAM_PROVIDER=local

# Required only when VECTAVOIP_DEFAULT_UPSTREAM_PROVIDER=twilio, or when a
# purchase request passes "upstream_provider": "twilio".
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_DEFAULT_VOICE_URL=
TWILIO_DEFAULT_SMS_URL=
TWILIO_BYOC_TRUNK_SID=
