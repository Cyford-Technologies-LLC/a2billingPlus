COMPOSE_PROJECT_NAME=a2billingplus

A2BP_HTTP_PORT=8080
A2BP_HTTP_84_PORT=8084
A2BP_DB_PORT=3307
A2BP_REDIS_PORT=6379
A2BP_ASTERISK_AMI_PORT=5038
A2BP_ASTERISK_ARI_PORT=8088
A2BP_ASTERISK_SIP_PORT=5060
A2BP_ASTERISK_RTP_START=10000
A2BP_ASTERISK_RTP_END=10020

MYSQL_DATABASE=mya2billing
MYSQL_USER=a2billinguser
MYSQL_PASSWORD=a2billing
MYSQL_ROOT_PASSWORD=a2billing-root

A2BP_DB_HOST=db
A2BP_DB_NAME=mya2billing
A2BP_DB_USER=a2billinguser
A2BP_DB_PASSWORD=a2billing
A2BP_SECRET_DIR=
A2BP_API_SERVICE_KEY=
A2BP_API_SERVICE_KEY_FILE=
# Comma-separated app_id:token pairs allowed to create/recover customers by external_id.
# Example: A2BP_CUSTOMER_PROVISIONING_APPS=crm_42:change-me-long-random-token
A2BP_CUSTOMER_PROVISIONING_APPS=
A2BP_UI_THEME=a2billingplus

ASTERISK_AMI_USER=a2billing
ASTERISK_AMI_PASSWORD=a2billing-ami
ASTERISK_ARI_USER=a2billing
ASTERISK_ARI_PASSWORD=a2billing-ari

VECTAVOIP_API_BASE_URL=https://api.vectavoip.com
VECTAVOIP_INSTALL_KEY=
VECTAVOIP_INSTALLATION_ID=
VECTAVOIP_API_KEY=
VECTAVOIP_API_SECRET=
VECTAVOIP_API_KEY_FILE=
VECTAVOIP_API_SECRET_FILE=
VECTAVOIP_WEBHOOK_SECRET=
VECTAVOIP_WEBHOOK_SECRET_FILE=

# Required in the admin UI before non-VectaVoIP provider/carrier modules such
# as Twilio are visible. Leave blank to keep locked providers hidden.
VECTAVOIP_PROVIDER_UNLOCK_TOKEN=

# DID upstream provider. Use "local" for cc_vectavoip_did_inventory, or
# "twilio" to purchase through Twilio from the VectaVoIP provider API.
VECTAVOIP_DEFAULT_UPSTREAM_PROVIDER=local

# Sandbox placeholders. TWILIO_SANDBOX_MODE=1 does not call Twilio or buy a real
# DID; it records a local PN_SANDBOX purchase for provider API testing.
TWILIO_SANDBOX_MODE=1
TWILIO_ACCOUNT_SID=AC_SANDBOX
TWILIO_API_KEY=SK_SANDBOX
TWILIO_API_SECRET=SANDBOX_SECRET
TWILIO_AUTH_TOKEN=
TWILIO_DEFAULT_VOICE_URL=http://localhost:8080/api/v1/twilio/voice
TWILIO_DEFAULT_SMS_URL=http://localhost:8080/api/v1/twilio/sms
TWILIO_ROUTING_MODE=elastic
TWILIO_ELASTIC_TRUNK_SID=
TWILIO_ELASTIC_TERMINATION_URI=vectavoip.pstn.twilio.com
TWILIO_ELASTIC_ORIGINATION_URI=sip:sip.vectavoip.com
TWILIO_SIP_DOMAIN=vectavoip.sip.twilio.com
TWILIO_BYOC_TRUNK_SID=
TWILIO_TRUNK_TECHNOLOGY=PJSIP
TWILIO_DEFAULT_CALLER_ID=

# To use Twilio Console test credentials instead of local sandbox mode, set
# TWILIO_SANDBOX_MODE=0, put the Test Account SID in TWILIO_ACCOUNT_SID, put the
# Test auth token in TWILIO_AUTH_TOKEN, and leave TWILIO_API_KEY/API_SECRET blank.

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_RESTRICTED_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_PUBLISHABLE_KEY=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_RESTRICTED_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=
PAYMENT_CURRENCY=USD
