# Copy this file to .env.stripe for local Stripe sandbox work.
# Keep .env.stripe uncommitted.

MODE=test
PAYMENT_CURRENCY=USD

# Stripe test publishable key from Developers > API keys.
# Starts with pk_test_ and is safe for browser/client-side use.
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_replace_me

# Stripe test secret key from Developers > API keys. Starts with sk_test_.
# Leave empty when using a restricted key for payment-intent creation.
STRIPE_TEST_SECRET_KEY=sk_test_replace_me

# Optional Stripe test restricted key from Developers > API keys > Restricted keys.
# Starts with rk_test_. It can be used instead of STRIPE_TEST_SECRET_KEY when
# permissions include the payment operations this app needs.
STRIPE_TEST_RESTRICTED_KEY=rk_test_replace_me

# Stripe webhook signing secret from Developers > Webhooks > endpoint > Reveal signing secret.
# Starts with whsec_. This is required for webhook verification.
STRIPE_TEST_WEBHOOK_SECRET=whsec_replace_me

# Do not put live keys in this sandbox file. If live mode is needed, use a
# separate production secret store and MODE=live with STRIPE_LIVE_* names,
# including STRIPE_LIVE_RESTRICTED_KEY=rk_live_... when using restricted keys.
